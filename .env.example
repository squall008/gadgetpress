# ==============================================================================
# GadgetPress 本番・開発環境変数テンプレート（Render + Neon PostgreSQL）
# 実際の値は .env（ローカル）または Render の Environment Variables に設定し、
# .env は絶対に Git へコミットしないでください（.gitignore で除外済み）。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (Neon PostgreSQL)
# DATABASE_URL: アプリ実行用の Pooled 接続文字列（-pooler 付き + sslmode=require）
# DATABASE_URL_UNPOOLED: Prisma マイグレーション / db:push 用の Direct 接続文字列
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx-pooler.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx-xxxx.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# ------------------------------------------------------------------------------
# 2. Auth.js v5 / NextAuth (Render リバースプロキシ配下対応)
# 本番公開 URL（https://your-service.onrender.com 等）とランダムな32バイト以上の秘密鍵を設定
# 生成例: openssl rand -base64 32
# ------------------------------------------------------------------------------
AUTH_URL="https://your-app.onrender.com"
NEXTAUTH_URL="https://your-app.onrender.com"
AUTH_SECRET="replace-with-a-random-32byte-secret"
NEXTAUTH_SECRET="replace-with-a-random-32byte-secret"

# 初回 Google ログイン時に自動で管理者（admin）権限を付与するメールアドレス（カンマ区切り・任意）
ADMIN_EMAILS="your-admin@gmail.com"

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0
# Google Cloud Console の「承認済みのリダイレクト URI」に以下を追加してください:
#   https://your-app.onrender.com/api/auth/callback/google
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 4. 外部画像ストレージ（Cloudinary または Supabase Storage のいずれかを設定）
# ※ 両方設定されている場合は Cloudinary が優先されます
# ------------------------------------------------------------------------------

# [推奨] Option A: Cloudinary
# Cloudinary Dashboard の API Keys から取得（または CLOUDINARY_URL 1本でも指定可）
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_UPLOAD_FOLDER="gadgetpress"
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Option B: Supabase Storage（Cloudinary の代わりに使う場合）
# Supabase で公開（Public）バケットを作成し、Project URL と Service Role Key を設定
# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# SUPABASE_STORAGE_BUCKET="article-images"
